{
	"schemaVersion": 1,
	"id": "lunacountdown",
	"version": "${version}",
	"name": "LunaCountdown",
	"description": "Event countdowns and scheduled shutdowns for Luna backends. This build serves Minecraft 26.1 and up.",
	"authors": ["Belikhun"],
	"license": "All Rights Reserved",
	"environment": "server",
	"entrypoints": {
		"server": ["dev.belikhun.luna.countdown.fabric.bootstrap.LunaCountdownFabricMod"]
	},
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": ">=0.156.0",
		"lunacore": "*",
		"minecraft": ">=26",
		"java": ">=21"
	},
	"suggests": {
		"luckperms": "*"
	}
}
