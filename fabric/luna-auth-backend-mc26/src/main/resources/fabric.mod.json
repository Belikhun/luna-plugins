{
	"schemaVersion": 1,
	"id": "lunaauthbackend",
	"version": "${version}",
	"name": "LunaAuthBackend",
	"description": "Holds a player at the auth spawn until the proxy says they are authenticated. This build serves Minecraft 26.1 and up.",
	"authors": [
		"Belikhun"
	],
	"license": "All Rights Reserved",
	"environment": "server",
	"entrypoints": {
		"server": [
			"dev.belikhun.luna.auth.backend.fabric.bootstrap.LunaAuthBackendFabricMod"
		]
	},
	"mixins": [
		"lunaauthbackend.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": ">=0.156.0",
		"lunacore": "*",
		"lunacoremessaging": "*",
		"minecraft": ">=26",
		"java": ">=21"
	}
}
