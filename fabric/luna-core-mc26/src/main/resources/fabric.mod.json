{
	"schemaVersion": 1,
	"id": "lunacore",
	"version": "${version}",
	"name": "LunaCore",
	"description": "Fabric runtime foundation for Luna backend modules. This build serves Minecraft 26.1 and up.",
	"authors": ["Belikhun"],
	"license": "All Rights Reserved",
	"environment": "server",
	"entrypoints": {
		"server": ["dev.belikhun.luna.core.fabric.bootstrap.LunaCoreFabricMod"],
		"voicechat": ["dev.belikhun.luna.core.fabric.compat.voicechat.FabricSimpleVoiceChatPlugin"]
	},
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": ">=0.156.0",
		"minecraft": ">=26",
		"java": ">=21"
	},
	"suggests": {
		"luckperms": "*",
		"spark": "*",
		"voicechat": "*"
	}
}
