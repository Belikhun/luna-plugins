	"license": "All Rights Reserved",
	"environment": "server",
	"entrypoints": {
		"server": ["dev.belikhun.luna.vault.backend.fabric.bootstrap.LunaVaultBackendFabricMod"]
	},
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": ">=0.156.0",
		"lunacore": "*",
		"lunacoremessaging": "*",
		"minecraft": ">=26",
		"java": ">=21"
	}
}
