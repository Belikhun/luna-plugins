{
	"schemaVersion": 1,
	"id": "lunacountdown",
	"version": "${version}",
	"name": "LunaCountdown",
	"description": "Event countdowns and scheduled shutdowns for Luna backends. One build serves Minecraft 1.20 through 1.21.x.",
	"authors": ["Belikhun"],
	"license": "All Rights Reserved",
	"environment": "server",
	"entrypoints": {
		"server": ["dev.belikhun.luna.countdown.fabric.bootstrap.LunaCountdownFabricMod"]
	},
	"depends": {
		"fabricloader": ">=0.15.0",
		"fabric-api": ">=0.116.0",
		"lunacore": "*",
		"minecraft": ">=1.20 <2.0",
		"java": ">=21"
	},
	"suggests": {
		"luckperms": "*"
	}
}
