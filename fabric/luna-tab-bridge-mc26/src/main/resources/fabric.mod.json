{
	"schemaVersion": 1,
	"id": "lunatabbridge",
	"version": "${version}",
	"name": "LunaTabBridge",
	"description": "Answers the proxy's TAB mod with this backend's player state and placeholders. This build serves Minecraft 26.1 and up.",
	"authors": [
		"Belikhun"
	],
	"license": "All Rights Reserved",
	"environment": "server",
	"entrypoints": {
		"server": [
			"dev.belikhun.luna.tabbridge.fabric.bootstrap.LunaTabBridgeFabricMod"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": ">=0.156.0",
		"lunacore": "*",
		"lunacoremessaging": "*",
		"minecraft": ">=26",
		"java": ">=21"
	},
	"suggests": {
		"luckperms": "*"
	}
}
